import java.util.HashSet;

class Solution{
    public int[] findThePrefixCommonArray(int[] A, int[] B){

        int n=A.length;
        int[] C=new int[n];
        HashSet<Integer> seenInA=new HashSet<>();
        HashSet<Integer> seenInB=new HashSet<>();

        int commonCount=0;

        for(int i=0;i<n;i++){
            if(seenInB.contains(A[i])){
                commonCount++;
            }
            if(seenInA.contains(B[i])){
                commonCount++;
            }

            seenInA.add(A[i]);
            seenInB.add(B[i]);   

            if(A[i]==B[i]){
                commonCount++;
            }
            C[i]=commonCount;
        }
        return C;
    }
}
